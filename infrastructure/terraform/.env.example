# Copy this file to .env and fill in your secrets
# Then run: source .env

# ============================================================
# AWS Configuration
# ============================================================
export AWS_PROFILE="personal-terraform"

# ============================================================
# Terraform Logging (TRACE, DEBUG, INFO, WARN, ERROR)
# ============================================================
export TF_LOG="TRACE"
export TF_LOG_PATH="terraform-trace.log"

# ============================================================
# Environment Workspace
# ============================================================
export TF_WORKSPACE="devtest"

# ============================================================
# COST OPTIMIZATION: Secrets Manager
# ============================================================
# Set to "false" for dev/test to save ~$5-10/month
# Set to "true" for production for better security
export TF_VAR_use_secrets_manager="false"

# ============================================================
# Required Secrets
# ============================================================
export TF_VAR_jwt_secret="your-jwt-secret-here-min-32-chars"
export TF_VAR_stripe_secret_key="sk_test_your_stripe_secret_key"
export TF_VAR_stripe_webhook_signing_secret="whsec_your_webhook_secret"
export TF_VAR_fernet_key="your-fernet-key-here-32-bytes-base64-encoded"

# Optional: Stripe Connect
# export TF_VAR_stripe_client_id="ca_your_stripe_connect_client_id"

# Optional: SendGrid
# export TF_VAR_sendgrid_api_key="SG.your_sendgrid_api_key"

# Optional: Twilio
# export TF_VAR_twilio_account_sid="ACxxxxxxxxxxxxxxxxxxxxxxxxxx"
# export TF_VAR_twilio_auth_token="your_twilio_auth_token"
# export TF_VAR_twilio_phone_number="+1234567890"

# HOW TO GENERATE SECRETS:
#
# JWT Secret:    openssl rand -hex 32
# Fernet Key:    python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
