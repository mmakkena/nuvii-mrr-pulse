# MRR Pulse Terraform Variables
# Copy this file to terraform.tfvars and fill in your actual values

# AWS Configuration
aws_region  = "us-east-1"
environment = "prod"

# Required Secrets
jwt_secret                    = "your-jwt-secret-here"
stripe_secret_key             = "sk_test_..."
stripe_webhook_signing_secret = "whsec_..."
stripe_client_id              = "ca_..."  # ← ADD THIS! Get from Stripe Dashboard
fernet_key                    = "your-fernet-key-here"

# Optional: Stripe Billing (for MRRPulse subscriptions)
stripe_publishable_key = "pk_test_..."

# Optional: Email/SMS
sendgrid_api_key    = ""
twilio_account_sid  = ""
twilio_auth_token   = ""
twilio_phone_number = ""
from_email          = "alerts@mrrpulse.com"

# Cost Optimization (adjust based on environment)
use_secrets_manager = false  # Set to true for production
use_private_subnets = false  # false = no NAT gateways (~$90/month saved); use SSM bastion for DB access
use_fargate_spot    = false  # Set to true for non-critical workloads
