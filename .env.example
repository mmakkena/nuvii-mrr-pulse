# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mrrpulse

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# SQS Queue URLs (use LocalStack for local dev)
SQS_EVENTS_QUEUE_URL=http://localhost:4566/000000000000/mrrpulse-events
SQS_NOTIFICATIONS_QUEUE_URL=http://localhost:4566/000000000000/mrrpulse-notifications
SQS_RISK_QUEUE_URL=http://localhost:4566/000000000000/mrrpulse-risk

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# Stripe Connect (for connecting customer accounts)
STRIPE_CLIENT_ID=ca_xxx
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_xxx

# Stripe Billing (for MRRPulse subscriptions)
STRIPE_BILLING_SECRET_KEY=sk_test_xxx
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxx
STRIPE_PRICE_STARTER=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_TEAM=price_xxx

# Encryption
FERNET_KEY=

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=alerts@mrrpulse.com

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URLs
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:8000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
