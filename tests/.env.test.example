# Test environment variables
# Copy this to tests/.env.test and fill in real values for integration testing.
# tests/.env.test is gitignored — never commit real secrets.

# Webhook signing secret — must match the value configured in the backend
# For local dev, use the value from your docker-compose / local .env
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_your_local_or_test_secret_here

# Backend URL (defaults to localhost:8000 if not set)
TEST_API_BASE=http://localhost:8000
