# Environment
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mrrpulse

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Stripe Connect (for connecting customer Stripe accounts)
# Get these from: https://dashboard.stripe.com/test/connect/accounts/overview
STRIPE_CLIENT_ID=ca_xxxxxxxxxxxxxxxxxxxxx  # Get this from Stripe Connect settings
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx  # Your Stripe secret key
STRIPE_WEBHOOK_SIGNING_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx  # For webhooks

# Stripe Billing (for MRRPulse subscriptions - optional)
STRIPE_BILLING_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_BILLING_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx

# SendGrid (for emails)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxx
FROM_EMAIL=alerts@mrrpulse.com

# URLs
API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Encryption
FERNET_KEY=your-fernet-key-here  # Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
